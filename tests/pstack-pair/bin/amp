#!/usr/bin/env bash
# Fake Amp CLI for pair.sh tests. Every call is logged to $FAKE/amp.log.
# - the headless preflight (`amp ... -x <message>`): $FAKE/amp-fail holds the error an account that cannot answer prints.
# - a new orb thread (`amp -ox ... [--attach FILE] MESSAGE`) and a message to one (`amp threads continue T -ox ...`): each prints the
#   thread URL; the thread's messages go to $FAKE/amp-threads/<T>/<n>.txt and its attachments to <n>-<name> beside them. $FAKE/amp-ox-fail
#   holds the error a thread that cannot start prints.
# - `amp threads search --json -n N QUERY` ($FAKE/amp-search holds the threads a query can find).
# - `amp threads archive T`, `amp threads export T` ($FAKE/amp-mode is the agentMode it reports) and `amp threads context T`
#   ($FAKE/amp-context-<T>, else $FAKE/amp-context, is the JSON it prints; by default 10% of the window used, no compaction) and `amp threads usage T`
#   ($FAKE/amp-cost/T is the dollar figure it reports, $0.00 by default; `none` there prints no Cost line). The export reports
#   $FAKE/amp-state/<T> as lastKnownAgentState (state and updatedAt on one line; none when absent), the thread's delivered messages, and
#   one assistant message ending a turn (stopReason end_turn, as the real export has) for each ISO time in $FAKE/amp-turn-ends/<T>.
# - $FAKE/amp-preflight-fail: model names, one per line; the headless preflight (`amp ... -x`) fails with a usage-limit error for a --model listed there.
# - $FAKE/amp-kill-after-delivery: once, kills the calling process right after a message was delivered (the result is never recorded).
# - $FAKE/amp-upload-fail: how many more sends end in the upload error; with $FAKE/amp-upload-fail-after-delivery the message is
#   delivered first, as when the CLI loses the reply.
set -u
: "${FAKE:?}"
printf '%s\n' "$*" >>"$FAKE/amp.log"
deliver() {
	thread="$1"; shift
	dir="$FAKE/amp-threads/$thread"; mkdir -p "$dir"
	n=$(( $(find "$dir" -name '*.txt' | wc -l) + 1 ))
	message=""
	while [ $# -gt 0 ]; do
		case "$1" in
		--attach) cp "$2" "$dir/$n-$(basename "$2")"; shift 2 ;;
		--model|-m|--mode|--effort|--features|--title|--settings-file|--project|--orb-size) shift 2 ;;
		# As the real CLI: -x takes the token right after it as the message, unless that token is an option; any other word is no message.
		-ox) case "${2:-}" in -*|'') shift ;; *) message="$2"; shift 2 ;; esac ;;
		*) shift ;;
		esac
	done
	printf '%s\n' "$message" >"$dir/$n.txt"
	printf 'https://ampcode.com/threads/%s\n' "$thread"
	# $FAKE/amp-kill-after-delivery: the message is delivered and the process that ran this CLI dies before it records the result (once).
	if [ -e "$FAKE/amp-kill-after-delivery" ]; then rm -f "$FAKE/amp-kill-after-delivery"; kill -9 "$PPID"; fi
}
case "${1:-} ${2:-}" in
"threads continue")
	if [ -s "$FAKE/amp-upload-fail" ] && [ "$(cat "$FAKE/amp-upload-fail")" -gt 0 ]; then
		printf '%s' "$(( $(cat "$FAKE/amp-upload-fail") - 1 ))" >"$FAKE/amp-upload-fail"
		if [ -e "$FAKE/amp-upload-fail-after-delivery" ]; then t="$3"; shift 3; deliver "$t" "$@" >/dev/null; fi
		echo 'Error: Failed to attach /tmp/x/pstack.tgz: Attachment upload did not complete' >&2; exit 1
	fi
	# $FAKE/amp-continue-fail: the error a message to an existing thread prints.
	if [ -s "$FAKE/amp-continue-fail" ]; then cat "$FAKE/amp-continue-fail" >&2; exit 1; fi
	shift 2; t="$1"; shift; deliver "$t" "$@"; exit 0 ;;
"threads context") cat "$FAKE/amp-context-$3" 2>/dev/null || cat "$FAKE/amp-context" 2>/dev/null || printf '{"threadID":"%s","totalTokens":10000,"maxContextTokens":100000,"compactionCount":0}\n' "$3"; exit 0 ;;
"threads usage")
	cost="$(cat "$FAKE/amp-cost/$3" 2>/dev/null || echo 0.00)"
	if [ "$cost" = none ]; then printf 'role\nCovered by your subscription\n'; else printf 'role\nCost: $%s\nCovered by your subscription\n' "$cost"; fi
	exit 0 ;;
"threads search")
	# $FAKE/amp-search: the JSON list of threads a search can find ({id, title, text}); a query keeps those whose title or text holds it.
	python3 - "$FAKE" "${@: -1}" <<'PY'
import json, os, sys
fake, query = sys.argv[1], sys.argv[2]
query = ' '.join(w for w in query.replace('archived:false', '').replace('"', '').split() if not w.startswith('repo:')).lower()
try:
    hits = json.load(open(os.path.join(fake, 'amp-search')))
except OSError:
    hits = []
print(json.dumps([{'id': h['id'], 'title': h.get('title', ''), 'updatedAt': '2026-01-01T00:00:00.000Z'} for h in hits if query in (h.get('title', '') + ' ' + h.get('text', '')).lower()]))
PY
	exit 0 ;;
"threads archive") printf '%s\n' "$3" >>"$FAKE/amp-archived"; exit 0 ;;
"threads export")
	python3 - "$FAKE" "$3" <<'PY'
import json, os, sys
fake, t = sys.argv[1], sys.argv[2]
d = os.path.join(fake, 'amp-threads', t)
texts = sorted((f for f in os.listdir(d) if f.endswith('.txt')), key=lambda f: int(f[:-4])) if os.path.isdir(d) else []
msgs = [{'role': 'user', 'content': [{'type': 'text', 'text': open(os.path.join(d, f)).read()}]} for f in texts]
meta = {}
try:
    state, at = open(os.path.join(fake, 'amp-state', t)).read().split()
    meta['lastKnownAgentState'] = {'state': state, 'updatedAt': at}
except (OSError, ValueError):
    pass
try:
    for at in open(os.path.join(fake, 'amp-turn-ends', t)).read().split():
        msgs.append({'role': 'assistant', 'state': {'type': 'complete', 'stopReason': 'end_turn'}, 'createdAt': at, 'content': []})
except OSError:
    pass
try:
    mode = open(os.path.join(fake, 'amp-mode')).read().strip()
except OSError:
    mode = ''
print(json.dumps({'id': t, 'agentMode': mode, 'meta': meta, 'messages': msgs}))
PY
	exit 0 ;;
esac
for arg in "$@"; do
	if [ "$arg" = -ox ]; then
		if [ -s "$FAKE/amp-ox-fail" ]; then cat "$FAKE/amp-ox-fail" >&2; exit 1; fi
		n=$(( $(cat "$FAKE/amp-started" 2>/dev/null || echo 0) + 1 )); printf '%s' "$n" >"$FAKE/amp-started"
		deliver "$(printf 'T-00000000-0000-4000-8000-%012d' "$n")" "$@"
		exit 0
	fi
done
for arg in "$@"; do
	[ "$arg" = -x ] || continue
	prev=""
	for a in "$@"; do
		[ "$prev" = --model ] && grep -qxF -- "$a" "$FAKE/amp-preflight-fail" 2>/dev/null && { printf 'Error: usage limit reached for %s\n' "$a"; exit 1; }
		prev="$a"
	done
	if [ -s "$FAKE/amp-fail" ]; then cat "$FAKE/amp-fail"; exit 1; fi
	printf 'OK\n'; exit 0
done
printf 'fake amp: unhandled %s\n' "$*" >&2; exit 2
