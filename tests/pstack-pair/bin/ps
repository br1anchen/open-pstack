#!/bin/sh
# A fake ps for the permission tests. With FAKE_PS_TABLE set it answers `ps -o ppid=|comm=|args= -p PID` from that file, one
# process per line: pid, ppid, comm and args, tab separated. A pid of SELF stands for the first pid asked about, which is the
# shell that runs the command under test (its pid is not known when the table is written). FAKE_PS_FAIL lists `field:pid`
# pairs (pid SELF allowed) for which ps prints nothing and exits 1, as ps does for a process that has gone. A pid the table
# does not hold does the same. With FAKE_PS_TABLE unset this is the real ps.
if [ -z "${FAKE_PS_TABLE:-}" ]; then
	self_dir="$(cd "$(dirname "$0")" && pwd)"
	old_path="$PATH"
	PATH=""
	IFS=:
	for d in $old_path; do [ "$d" = "$self_dir" ] || PATH="${PATH:+$PATH:}$d"; done
	unset IFS
	exec ps "$@"
fi
[ "$1" = -o ] && [ "$3" = -p ] && [ $# -eq 4 ] || { echo "fake ps: unsupported arguments: $*" >&2; exit 2; }
field="${2%=}"
pid="$4"
first="$FAKE_PS_TABLE.first"
[ -f "$first" ] || printf '%s\n' "$pid" >"$first"
if [ "$pid" = "$(cat "$first")" ]; then key=SELF; else key="$pid"; fi
for f in ${FAKE_PS_FAIL:-}; do
	[ "$f" = "$field:$key" ] && exit 1
done
row="$(awk -F'\t' -v k="$key" '$1 == k { print; exit }' "$FAKE_PS_TABLE")"
[ -n "$row" ] || exit 1
case "$field" in
ppid) printf '%s\n' "$row" | awk -F'\t' '{ printf "%7s\n", $2 }' ;;
comm) printf '%s\n' "$row" | awk -F'\t' '{ print $3 }' ;;
args) printf '%s\n' "$row" | awk -F'\t' '{ s = $4; for (i = 5; i <= NF; i++) s = s "\t" $i; print s }' ;;
*) echo "fake ps: unsupported field: $field" >&2; exit 2 ;;
esac
