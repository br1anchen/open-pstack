#!/usr/bin/env bash
# Amp orb setup. Runs once per fresh orb (and again on a stale snapshot), so
# every step is idempotent and cheap when its result is already present. It
# readies an orb to run the pstack-kitchen workflow on this repo against
# .agents/kitchen.toml: the locked dev tools its gates use, the joo review
# engine it names, and this checkout's own skills linked into ~/.agents/skills.
# Docs: https://ampcode.com/docs/orbs, docs/agents/amp-orb-environment.md
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$repo_root"

step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

# ruff and ty, pinned in uv.lock, which the pstack profile's fast gates run.
install_dev_tools() {
  uv sync --frozen --quiet
}

# joo (Judge of Owls) is the review engine .agents/kitchen.toml names. Setup
# runs with no user identity, so it cannot build joo from the private
# br1anchen/judge_of_owls; .agents/resume starts that build in the thread
# (.agents/joo-build). Setup installs what needs no identity: the Claude CLI
# joo reviews through, joo's config, and a joo-dev stub that waits for the
# build, or runs it, before each review; the build replaces the stub. None of
# them holds a secret. A failure only warns.
install_joo_stub() {
  command -v claude >/dev/null || npm install --global --silent @anthropic-ai/claude-code \
    || printf 'joo: warning: could not install the Claude CLI\n'
  mkdir -p "$HOME/.joo" "$HOME/.local/bin"
  [[ -f "$HOME/.joo/config.json" ]] || printf '{ "agentTiers": "claude:opus" }\n' > "$HOME/.joo/config.json"
  [[ -f "$HOME/.local/bin/.joo-revision" ]] && return 0
  # The stub is one compound command, which bash reads whole before running
  # it, because the build overwrites this file while a review waits in it.
  printf '%s\n' \
    '#!/usr/bin/env bash' \
    '# joo-dev stub from .agents/setup; the joo build replaces it.' \
    "{ \"$repo_root/.agents/joo-build\" wait >&2 && exec \"\$HOME/.local/bin/joo-dev\" \"\$@\"; exit; }" \
    > "$HOME/.local/bin/joo-dev"
  chmod +x "$HOME/.local/bin/joo-dev"
  printf 'joo: stub installed; .agents/resume builds joo in the thread\n'
}

# The skills are this repo, so the kitchen runs from this checkout: its own
# installer links skills/* into ~/.agents/skills (and ~/.claude/skills,
# ~/.grok/skills), and an edit to the checkout is what the next command runs.
# No builds.tsv row is written: the linked skills are the working tree, which
# the kitchen commits to as it runs, so no one revision is the build a run
# used, and fleet and feedback show it as unknown. The project environment
# variables PSTACK_MUX=amp, XDG_STATE_HOME under .amp/in/orb-backup/pstack
# and PSTACK_SCRATCH_ROOT carry the orb-specific settings into every agent
# shell; ~/.bash_profile would not, because agent tools run `bash -c`.
install_pstack() {
  python3 scripts/pstack-sync.py --apply >/dev/null
  printf 'pstack: skills linked from %s\n' "$repo_root/skills"
}

# The skills go first: they need nothing the later steps install, so a uv or
# joo failure never leaves the orb without them.
step "pstack-kitchen skills" install_pstack
step "uv dev tools" install_dev_tools
step "joo review engine stub" install_joo_stub
